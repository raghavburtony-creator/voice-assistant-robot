{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otto",
  "version": "0.1.0",
  "identifier": "com.otto.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev -- --host 127.0.0.1",
      "cwd": "..",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": ".."
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Otto",
        "width": 420,
        "height": 640,
        "minWidth": 320,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
