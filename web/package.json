{
  "name": "otto-voice-kit-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:lib": "vite build -c vite.lib.config.ts && vite build -c vite.adapters.config.ts && tsc -p tsconfig.lib.json && node scripts/check-dist.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "desktop:dev": "npx --yes @tauri-apps/cli@^2 dev",
    "desktop:build": "npx --yes @tauri-apps/cli@^2 build"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "20.14.6",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.1"
  },
  "exports": {
    ".": {
      "types": "./dist-lib/types/otto/element/index.d.ts",
      "import": "./dist-lib/otto-mascot.js"
    },
    "./react": {
      "types": "./dist-lib/types/otto/react/index.d.ts",
      "import": "./dist-lib/react.js"
    },
    "./gemini": {
      "types": "./dist-lib/types/otto/gemini/index.d.ts",
      "import": "./dist-lib/gemini.js"
    }
  },
  "module": "./dist-lib/otto-mascot.js",
  "types": "./dist-lib/types/otto/element/index.d.ts",
  "files": [
    "dist-lib"
  ],
  "sideEffects": [
    "./dist-lib/otto-mascot.js",
    "./src/otto/element/index.ts",
    "*.css"
  ],
  "peerDependencies": {
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
