{
  "name": "otto-voice-kit-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.1"
  },
  "exports": {
    ".": {
      "types": "./dist-lib/types/otto/element/index.d.ts",
      "import": "./dist-lib/otto-mascot.js"
    }
  },
  "module": "./dist-lib/otto-mascot.js",
  "types": "./dist-lib/types/otto/element/index.d.ts",
  "files": [
